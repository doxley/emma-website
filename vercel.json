{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/make-a-booking(/.*)?",
      "destination": "/#book",
      "permanent": true
    },
    {
      "source": "/my-account(/.*)?",
      "destination": "/#book",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page_id",
          "value": "3"
        }
      ],
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacy-policy(/.*)?",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/product(/.*)?",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/product-category(/.*)?",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/cart(/.*)?",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/checkout(/.*)?",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/wp-admin(/.*)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/feed(/.*)?",
      "destination": "/",
      "permanent": true
    }
  ]
}